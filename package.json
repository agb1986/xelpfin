{
  "name": "xelpfin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "jellyfin:up": "bash scripts/jellyfin-up.sh",
    "jellyfin:down": "bash scripts/jellyfin-down.sh",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "emu:start": "bash scripts/emulator.sh start",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81.5-2",
    "react-native-video": "6.19.3"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/eslint-config": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
