<?xml version="1.0" encoding="utf-8"?>
<!-- Home Jellyfin servers are usually plain http on the LAN, so cleartext is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
